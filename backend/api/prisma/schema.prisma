generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  LAB_TECH
  PHARMACIST
  RECEPTIONIST
  PATIENT
}
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabPriority {
  ROUTINE
  URGENT
}
enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}
enum StockMovementType {
  RECEIVE
  DISPENSE
  ADJUST
}
model Organization {
  id        String     @id @default(uuid())
  name      String
  hospitals Hospital[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Hospital {
  medicalRecords MedicalRecord[]
  doctorProfiles DoctorProfile[]
  wards          Ward[]
  beds           Bed[]
  admissions     Admission[]
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String       @unique
  address        String?
  phone          String?
  email          String?
   users          User[]
  departments    Department[]
  patients       Patient[]
    appointments   Appointment[]
      consultations  Consultation[]
        labOrders      LabOrder[]
          prescriptions  Prescription[]
            medicines      Medicine[]
              invoices       Invoice[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
model Patient {
  medicalRecord MedicalRecord?
  admissions    Admission[]
  id          String    @id @default(uuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])
  mrn         String
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  phone       String?
  email       String?
  address     String?
    appointments Appointment[]
      consultations Consultation[]
        labOrders     LabOrder[]
          prescriptions Prescription[]
            invoices      Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hospitalId, mrn])
  @@index([hospitalId])
  @@index([hospitalId, lastName])
}

model User {
  doctorProfile DoctorProfile?
  id            String         @id @default(uuid())
  hospitalId    String?
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id])
    departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role
  status        UserStatus     @default(ACTIVE)
  refreshTokens RefreshToken[]
    doctorAppointments Appointment[] @relation("DoctorAppointments")
      doctorConsultations Consultation[] @relation("DoctorConsultations")
        orderedLabs         LabOrder[] @relation("OrderedLabs")
  enteredLabResults   LabOrder[] @relation("EnteredLabResults")
    prescribed          Prescription[] @relation("PrescribedBy")
  dispensed           Prescription[] @relation("DispensedBy")
    stockMovements      StockMovement[]
      createdInvoices     Invoice[] @relation("InvoiceCreatedBy")
  receivedPayments    Payment[] @relation("PaymentReceivedBy")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([hospitalId])
    @@index([departmentId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Department {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
}
model Appointment {
  id         String            @id @default(uuid())
  hospitalId String
  hospital   Hospital          @relation(fields: [hospitalId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([hospitalId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
}
  model Consultation {
  id            String   @id @default(uuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        User     @relation("DoctorConsultations", fields: [doctorId], references: [id])
  appointmentId String?
  complaint     String
  diagnosis     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hospitalId, patientId])
  @@index([doctorId])
}

model AuditLog {
  id         String   @id @default(uuid())
  hospitalId String?
  userId     String
  action     String
  entity     String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([entity, entityId])
}
model LabOrder {
  id           String         @id @default(uuid())
  hospitalId   String
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id])
  orderedById  String
  orderedBy    User           @relation("OrderedLabs", fields: [orderedById], references: [id])
  testName     String
  priority     LabPriority    @default(ROUTINE)
  status       LabOrderStatus @default(ORDERED)
  result       String?
  resultById   String?
  resultBy     User?          @relation("EnteredLabResults", fields: [resultById], references: [id])
  resultAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([hospitalId, status])
  @@index([hospitalId, patientId])
}
model Prescription {
  id            String             @id @default(uuid())
  hospitalId    String
  hospital      Hospital           @relation(fields: [hospitalId], references: [id])
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  prescriberId  String
  prescriber    User               @relation("PrescribedBy", fields: [prescriberId], references: [id])
  status        PrescriptionStatus @default(PENDING)
  notes         String?
  items         PrescriptionItem[]
  dispensedById String?
  dispensedBy   User?              @relation("DispensedBy", fields: [dispensedById], references: [id])
  dispensedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([hospitalId, status])
  @@index([hospitalId, patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       String
  dose           String
  frequency      String
  durationDays   Int
  quantity       Int           @default(1)
  @@index([prescriptionId])
}
model Medicine {
  id         String          @id @default(uuid())
  hospitalId String
  hospital   Hospital        @relation(fields: [hospitalId], references: [id])
  name       String
  unit       String
  quantity   Int             @default(0)
  reorderAt  Int             @default(10)
  movements  StockMovement[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model StockMovement {
  id         String            @id @default(uuid())
  hospitalId String
  medicineId String
  medicine   Medicine          @relation(fields: [medicineId], references: [id])
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  type       StockMovementType
  change     Int
  reason     String?
  createdAt  DateTime          @default(now())

  @@index([hospitalId, medicineId])
}
enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

model Invoice {
  id          String        @id @default(uuid())
  hospitalId  String
  hospital    Hospital      @relation(fields: [hospitalId], references: [id])
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])
  number      String
  status      InvoiceStatus @default(PENDING)
  total       Int
  paidAmount  Int           @default(0)
  createdById String
  createdBy   User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([hospitalId, number])
  @@index([hospitalId, status])
  @@index([hospitalId, patientId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(uuid())
  hospitalId   String
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Int
  method       PaymentMethod
  receivedById String
  receivedBy   User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([hospitalId, invoiceId])
}


enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Ward {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  name        String
  description String?
  beds        Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Bed {
  id          String      @id @default(uuid())
  hospitalId  String
  hospital    Hospital    @relation(fields: [hospitalId], references: [id])
  wardId      String
  ward        Ward        @relation(fields: [wardId], references: [id])
  label       String
  status      BedStatus   @default(AVAILABLE)
  admissions  Admission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([wardId, label])
  @@index([hospitalId, status])
}

model Admission {
  id           String    @id @default(uuid())
  hospitalId   String
  hospital     Hospital  @relation(fields: [hospitalId], references: [id])
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  bedId        String
  bed          Bed       @relation(fields: [bedId], references: [id])
  admittedById String
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
  notes        String?

  @@index([hospitalId, patientId])
  @@index([bedId])
}


model DoctorProfile {
  id            String   @id @default(uuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  licenseNumber String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hospitalId])
}


model MedicalRecord {
  id                String   @id @default(uuid())
  hospitalId        String
  hospital          Hospital @relation(fields: [hospitalId], references: [id])
  patientId         String   @unique
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bloodGroup        String?
  allergies         String?
  chronicConditions String?
  familyHistory     String?
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([hospitalId])
}